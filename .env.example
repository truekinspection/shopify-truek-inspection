# 1. DATABASE
DATABASE_URL=

# 2. APP URLS
NEXT_PUBLIC_URL="https://www.usa.truekinspection.com/"
NEXT_PUBLIC_APP_URL="https://www.usa.truekinspection.com/"

# 3. EMAIL (RESEND)
RESEND_API_KEY=
# Ops inbox for payment/report notifications (defaults to truekinspection@gmail.com)
OWNER_EMAIL=truekinspection@gmail.com
RESEND_EMAIL=

# 4. Shopify checkout (see SHOPIFY_SETUP.md)
# IMPORTANT: put comments on their own lines — do not append " # comment" on the same line as a value.
# Store hostname only — no https://
SHOPIFY_STORE_DOMAIN=
# Admin API token from custom/Partner app install (shpat_...)
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Storefront API token (preferred for cart checkout). Not the Admin shpat_ token.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_KEY=
# Verifies webhook HMAC (orders/paid). Also used if SHOPIFY_WEBHOOK_SECRET is empty.
SHOPIFY_API_SECRET=
# Optional; defaults to SHOPIFY_API_SECRET if unset
SHOPIFY_WEBHOOK_SECRET=
# Numeric variant id or gid://shopify/ProductVariant/...
SHOPIFY_PRODUCT_VARIANT_ID=
# Cart/order attribute key for VIN (default vin)
SHOPIFY_VIN_ATTRIBUTE_KEY=vin
# App needs write_draft_orders if Storefront cart is unavailable.
# Optional Admin GraphQL API version pin
# SHOPIFY_API_VERSION=2025-01

# 5. CLEARVIN API (v2.0 vendor REST)
# Environment switch:
#   CLEARVIN_ENV=test|production  (optional; defaults from NODE_ENV)
# Test / staging: static Bearer token — no login. Only approved test VINs work.
# Production: email/password login → JWT (120m), auto-refresh before expiry.
CLEARVIN_ENV=
CLEARVIN_TEST_TOKEN=
CLEARVIN_EMAIL=
CLEARVIN_PASSWORD=
